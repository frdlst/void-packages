#!/bin/sh
exec 2>&1
[ -r ./conf ] && . ./conf
sv check dbus >/dev/null || exit 1

# Upstream's postinst seeds the config DB; do it here so it also self-heals.
if [ ! -f /var/lib/forticlient/config.db ]; then
	cp /opt/forticlient/.config.db.init /var/lib/forticlient/config.db
	chmod 600 /var/lib/forticlient/config.db
fi

# FortiClient only restores /etc/resolv.conf on a graceful disconnect, so a
# crash while connected leaves its override behind and the network looks broken
# after the next boot. No VPN can be up this early, so an override here is
# stale.
backup=/etc/resolv.conf.forticlient.backup
if [ -f "$backup" ] && grep -q "generated by forticlient" /etc/resolv.conf 2>/dev/null; then
	echo "Stale FortiClient resolv.conf override found, restoring backup"
	mv -f "$backup" /etc/resolv.conf
fi

# fctsched's compliance reports demand Ubuntu in /etc/os-release. Give it (and
# everything it forks) a private mount namespace where only it sees the spoof,
# rather than lying to the whole system.
exec unshare --mount --propagation private -- \
	sh -c 'mount --bind /etc/forticlient-os-release-spoof /etc/os-release && exec /opt/forticlient/fctsched'
