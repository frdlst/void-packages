# Template file for 'bitwarden-desktop'
pkgname=bitwarden-desktop
version=2026.10.1
revision=1
# electron-builder bundles upstream's prebuilt (glibc) Electron;
# Void's electron is too old for what upstream pins
archs="x86_64 aarch64"
build_wrksrc=apps/desktop
build_helper="rust"
hostmakedepends="nodejs python3 pkg-config cargo"
makedepends="sqlite-devel"
short_desc="Bitwarden password manager desktop client"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-only"
homepage="https://bitwarden.com"
changelog="https://github.com/bitwarden/clients/releases"
distfiles="https://github.com/bitwarden/clients/archive/refs/tags/desktop-v${version}.tar.gz"
checksum=3dd92f8788684acba5864c4c2a6be594463a57c7aa3473dafb6683b98a245a9b
nocross=yes
nostrip_files="bitwarden-app"

export NODE_OPTIONS="--max_old_space_size=4096"

do_configure() {
	cd "$wrksrc"
	# only husky and electron-rebuild hooks live here; electron-builder
	# rebuilds the app's native deps itself during packing
	npm ci --ignore-scripts --no-audit --no-fund
}

do_build() {
	( cd desktop_native && node build.js --release )
	# OSS build: excludes bitwarden_license/ code
	npm run build
	npm run pack:dir
}

do_install() {
	vmkdir usr/lib/bitwarden
	vcopy dist/linux*-unpacked/* usr/lib/bitwarden

	vmkdir usr/bin
	ln -s /usr/lib/bitwarden/bitwarden "${DESTDIR}/usr/bin/bitwarden"

	vinstall resources/com.bitwarden.desktop.desktop 644 usr/share/applications
	# polkit action used for biometric/system-auth unlock
	vinstall resources/com.bitwarden.desktop.policy 644 usr/share/polkit-1/actions

	for size in 16 32 64 128 256 512 1024; do
		vinstall resources/icons/${size}x${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps com.bitwarden.desktop.png
	done
}
